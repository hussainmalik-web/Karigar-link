# Optional real mobile OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Local Personal AI Assistant model used inside the existing Karigar Link chat panel
KARIGAR_ASSISTANT_OLLAMA=1
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=llama3.2:1b

# Admin console key for local development. Replace with a long random secret before any network deployment.
KARIGAR_ADMIN_KEY=replace-this-with-a-long-random-secret
